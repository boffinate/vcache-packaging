[Unit]
Description=Vinyl Cache, a high-performance HTTP accelerator
After=network-online.target nss-lookup.target

[Service]
Type=forking
KillMode=mixed
LimitNOFILE=131072
LimitMEMLOCK=100M
TasksMax=infinity
LimitCORE=infinity
RuntimeDirectory=%N
PIDFile=%t/%N/vinyld.pid
ExecStart=/usr/sbin/vinyld \
      -a :80 \
      -a localhost:8443,PROXY \
      -f /etc/vinyl-cache/default.vcl \
      -P %t/%N/vinyld.pid \
      -p feature=+http2 \
      -s malloc,256m
ExecReload=/usr/sbin/vinylreload

[Install]
WantedBy=multi-user.target
