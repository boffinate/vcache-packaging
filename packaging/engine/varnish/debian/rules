#!/usr/bin/make -f
# Varnish family engine packaging for the matrix quality bar. The build script
# generates debian/changelog from the family contract. Exact installed-file
# manifests remain a target-container proof before this family can publish.

DEB_HOST_MULTIARCH ?= $(shell dpkg-architecture -qDEB_HOST_MULTIARCH)

# Preserve Varnish's own state/configuration defaults. The compile-only load
# check needs conventional /usr paths and the target's native library dir.
CONFIGURE_FLAGS = \
	--libdir=/usr/lib/$(DEB_HOST_MULTIARCH) \
	--with-unwind

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- $(CONFIGURE_FLAGS)

override_dh_auto_test:

override_dh_auto_install:
	dh_auto_install
	find debian/tmp \( -name '*.la' -o -name '*.a' \) -delete
