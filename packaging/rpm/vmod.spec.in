# @PACKAGE_NAME@ -- GENERATED by tools/recipe.py from vmods/@VMOD_ID@.yml.
# Do not edit: a hand edit is lost on the next generation.

# The VMOD is a dlopen()ed plugin, not a system library: suppress its
# automatic soname Provides while leaving Requires generation intact.
%global vmoddir %{_libdir}/vinyl-cache/vmods
%global __provides_exclude_from ^%{vmoddir}/.*\\.so$

# Serial build: VMOD vmodtool.py make rules race under -j (duplicate vcc_if
# generation), the same reason debian/rules passes dh --no-parallel and the
# compat harness retries serially. Overriding _smp_mflags covers both
# %%make_build and %%make_install.
%global _smp_mflags -j1

Name:           @PACKAGE_NAME@
Version:        @RPM_VERSION@
Release:        @RPM_RELEASE@%{?dist}
Summary:        @SUMMARY@

License:        @LICENSE@
URL:            @HOMEPAGE@
Source0:        @PACKAGE_NAME@-@RPM_VERSION@.tar.gz

@RPM_BUILD_REQUIRES@

Requires:       vinyl-cache%{?_isa} = @ENGINE_RPM_PKG_VERSION@

%description
@RPM_DESCRIPTION@

Built against Vinyl Cache @ENGINE_VERSION@ (engine @ENGINE_ID@), upstream
ref @VMOD_REF@.

%prep
%autosetup -n @PACKAGE_NAME@-@RPM_VERSION@

%build
# Same bootstrap ladder as the compat harness (scripts/build-vmod.sh): prefer
# upstream's own bootstrap/autogen.sh, because it knows how to locate the
# engine's aclocal macros. cachetag's, for one, exports VINYLAPI_DATAROOTDIR
# from pkg-config and mkdir -p m4 before autoreconf; a bare autoreconf leaves
# that make variable unexpanded and dies on "couldn't open directory
# '/aclocal'". Fall back to autoreconf only when upstream ships neither.
if [ ! -x configure ]; then
  if [ -f bootstrap ]; then sh ./bootstrap
  elif [ -f autogen.sh ]; then sh ./autogen.sh
  else autoreconf -fi; fi
fi
%configure
%make_build @BUILD_TARGET@

%install
%make_install
# Ship the VMOD shared object and nothing else: upstream-installed docs and
# man pages would otherwise fail the build as installed-but-unpackaged.
rm -rf %{buildroot}%{_docdir} %{buildroot}%{_mandir}
find %{buildroot} \( -name '*.la' -o -name '*.a' \) -delete

%files
%{vmoddir}/*.so

%changelog
* @RPM_DATE@ @MAINTAINER_NAME@ <@MAINTAINER_EMAIL@> - @RPM_VERSION@-@RPM_RELEASE@
- Generated from vmods/@VMOD_ID@.yml; do not edit by hand.
- Upstream ref @VMOD_REF@, built against Vinyl Cache @ENGINE_VERSION@.
