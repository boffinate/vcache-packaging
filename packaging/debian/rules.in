#!/usr/bin/make -f
# @PACKAGE_NAME@ -- GENERATED by tools/recipe.py from vmods/@VMOD_ID@.yml.
# Do not edit: a hand edit is lost on the next generation.

# --no-parallel: VMOD vmodtool.py make rules race under -j (duplicate
# vcc_if generation), the same reason the compat harness retries serially.
%:
	dh $@ --no-parallel

override_dh_auto_install:
	dh_auto_install
	find debian/@PACKAGE_NAME@ \( -name '*.la' -o -name '*.a' \) -delete
