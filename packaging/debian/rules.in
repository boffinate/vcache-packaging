#!/usr/bin/make -f
# @PACKAGE_NAME@ -- GENERATED by tools/recipe.py from vmods/@VMOD_ID@.yml.
# Do not edit: a hand edit is lost on the next generation.

# --no-parallel: VMOD vmodtool.py make rules race under -j (duplicate
# vcc_if generation), the same reason the compat harness retries serially.
%:
	dh $@ --no-parallel

# Mirror the compat/RPM bootstrap ladder.  Some upstream git trees, including
# cachetag, need their own bootstrap script to create m4 and locate the
# engine's aclocal macros; dh_autoreconf alone then searches a bogus /aclocal.
override_dh_autoreconf:
	if [ ! -x configure ]; then \
	  if [ -f bootstrap ]; then sh ./bootstrap; \
	  elif [ -f autogen.sh ]; then sh ./autogen.sh; \
	  else autoreconf -fi; fi; \
	fi

# Upstream test suites run only via the compat lane's `tests:` opt-in
# (DESIGN.md); dh would otherwise run `make check` inside every package
# build, importing per-suite flakes into package cells. The RPM spec has no
# %check for the same reason.
override_dh_auto_test:

override_dh_auto_install:
	dh_auto_install
	find debian/@PACKAGE_NAME@ \( -name '*.la' -o -name '*.a' \) -delete
