#!/usr/bin/make -f
# @PACKAGE_NAME@ -- GENERATED by tools/recipe.py from vmods/@VMOD_ID@.yml.
# Do not edit: a hand edit is lost on the next generation.

# --no-parallel: VMOD vmodtool.py make rules race under -j (duplicate
# vcc_if generation), the same reason the compat harness retries serially.
%:
	dh $@ --no-parallel

ifeq (@CARGO_BUILD@,1)

override_dh_auto_configure:
	:

override_dh_auto_build:
	cargo build --release --locked --offline @CARGO_FEATURE_ARGS@

override_dh_auto_test:
	:

override_dh_auto_install:
	python3 /repo/tools/cargo-artifacts.py \
	  --release-dir "$${CARGO_TARGET_DIR:?}/release" \
	  --destination "debian/@PACKAGE_NAME@$$(pkg-config --variable=vmoddir @ENGINE_API@)" \
	  @CARGO_ARTIFACT_ARGS@

else

# Mirror the compat/RPM bootstrap ladder.  Some upstream git trees, including
# cachetag, need their own bootstrap script to create m4 and locate the
# engine's aclocal macros; dh_autoreconf alone then searches a bogus /aclocal.
override_dh_autoreconf:
	if [ ! -x configure ]; then \
	  if [ -f bootstrap ]; then sh ./bootstrap; \
	  elif [ -f autogen.sh ]; then sh ./autogen.sh; \
	  else autoreconf -fi; fi; \
	fi

# configure.ac in a few upstream projects owns debian/* and their distclean
# removes it. Restore our generated metadata before the remaining dh clean
# helpers inspect it; the private copy is outside upstream's build contract.
restore_vcache_debian_metadata:
	for file in control changelog copyright source/format; do \
	  test -f "debian/.vcache-packaging/$$file"; \
	  mkdir -p "$$(dirname "debian/$$file")"; \
	  cp "debian/.vcache-packaging/$$file" "debian/$$file"; \
	done

restore_upstream_debian_inputs:
	find debian/.vcache-upstream -type f -name '*.in' -print 2>/dev/null | while IFS= read -r file; do \
	  target=$${file#debian/.vcache-upstream/}; \
	  mkdir -p "$$(dirname "debian/$$target")"; \
	  cp "$$file" "debian/$$target"; \
	done

override_dh_auto_clean:
	dh_auto_clean
	$(MAKE) -f debian/rules restore_vcache_debian_metadata

# Source checkouts are disposable and bootstrap has already run before their
# Debian metadata is replaced. A second autoreconf-clean pass would restore
# upstream's generated packaging files over the generated recipe.
override_dh_autoreconf_clean:
	:

override_dh_auto_configure:
	$(MAKE) -f debian/rules restore_upstream_debian_inputs
	dh_auto_configure -- @CONFIGURE_ARGS@
	$(MAKE) -f debian/rules restore_vcache_debian_metadata

override_dh_auto_build:
	dh_auto_build -- @BUILD_TARGET@

# Upstream test suites run only via the compat lane's `tests:` opt-in
# (DESIGN.md); dh would otherwise run `make check` inside every package
# build, importing per-suite flakes into package cells. The RPM spec has no
# %check for the same reason.
override_dh_auto_test:

override_dh_auto_install:
	dh_auto_install
	python3 /repo/tools/vmod-artifacts.py \
	  --stage-root "debian/@PACKAGE_NAME@" \
	  --vmod-dir "$$(pkg-config --variable=vmoddir @ENGINE_API@)" \
	  --modules @VMOD_MODULES@

endif
