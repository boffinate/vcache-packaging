# Varnish 9 survey lane: Debian 13 with Varnish Cache built from the pinned
# upstream release tarball, plus the common third-party build surface.
#
# Layering: toolchain -> varnish build -> common VMOD dependency set, so that
# growing the dependency set does not recompile varnish. Keep the common set
# (last RUN apt-get) identical to Dockerfile.vinyl9 so a missing dependency
# fails the same way on both lanes.
ARG IMAGE
FROM ${IMAGE}

ARG VARNISH_SOURCE_SHA256
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential autoconf automake autoconf-archive libtool pkg-config git ca-certificates curl \
    python3 python3-docutils python3-sphinx \
    libpcre2-dev libedit-dev libncurses-dev libjemalloc-dev libunwind-dev libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY stage/varnish-9.0.3.tar.gz /tmp/varnish.tar.gz
RUN echo "${VARNISH_SOURCE_SHA256}  /tmp/varnish.tar.gz" | sha256sum -c - \
    && mkdir /tmp/varnish-src \
    && tar -xzf /tmp/varnish.tar.gz -C /tmp/varnish-src --strip-components=1 \
    && cd /tmp/varnish-src \
    && ./configure --prefix=/usr/local \
    && make -j"$(nproc)" \
    && make install \
    && ldconfig \
    && rm -rf /tmp/varnish-src /tmp/varnish.tar.gz

# Common third-party VMOD dependency set — keep identical to Dockerfile.vinyl9.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl-dev zlib1g-dev libcurl4-openssl-dev libmaxminddb-dev libgeoip-dev \
    libjansson-dev libbrotli-dev libev-dev libevent-dev uuid-dev libossp-uuid-dev \
    libhiredis-dev libmemcached-dev libgcrypt20-dev libgd-dev libmhash-dev \
    libluajit-5.1-dev libre2-dev default-libmysqlclient-dev libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

# varnish.m4 lands in /usr/local/share/aclocal, which aclocal does not search
# by default.
ENV ACLOCAL_PATH=/usr/local/share/aclocal

ARG SHIM_API_VERSION
COPY make-reverse-shim.sh /harness/make-reverse-shim.sh
RUN SHIM_API_VERSION="${SHIM_API_VERSION}" sh /harness/make-reverse-shim.sh

RUN varnishd -V && pkg-config --modversion varnishapi && pkg-config --modversion vinylapi && vinyld -V

COPY build-and-load.sh /harness/build-and-load.sh
RUN chmod +x /harness/build-and-load.sh

ENV LANE=varnish9 DAEMON=varnishd
