# Pinned inputs for the EL9 lane.
#
# This file is a stand-in for the cohort/target registry manifests. The registry
# schema (registry/README.md) currently describes cachetag packages only; it has
# no fields for the Vinyl runtime/devel package version or for the Vinyl source
# archive, so those values cannot yet be generated with
# `tools/release_tool.py metadata`. Until the schema grows them, this file is the
# single place the EL9 lane reads its identity from: no version string, package
# revision or ABI hash is hand-written into a spec file.
#
# Every value here is an immutable input, not a build output.
#
# Two-track model, added 2026-07-26: "trunk" builds from the pinned Vinyl
# Cache Git snapshot and exists to catch VMOD breakage and strict-ABI churn
# early; "release" builds from the upstream release tarball and is what
# users install. Select with VINYL_TRACK=release|trunk; since 2026-07-28 it
# defaults to RELEASE -- the cutover happened after the release track's
# lanes, smoke, VTC suite, transaction matrix, and release-draft assembly
# all ran green. The trunk legs are unaffected: ci.yml's matrix and the
# scheduled nightly select their track explicitly.

# --- Vinyl Cache -------------------------------------------------------------

VINYL_VTEST2_COMMIT=db5ccb4a078da40b3ec1ca3c18bf498bb1520888

VINYL_TRACK=${VINYL_TRACK:-release}
case $VINYL_TRACK in
release)
	# Drafted 2026-07-26, unexecuted until the first release-track build:
	# builds from the upstream release tarball rather than a Git checkout.
	# Tarball digest and baked ABI string verified against the downloaded
	# upstream tarball on 2026-07-26.
	VINYL_GIT_COMMIT=423648c4cb6b225b3268ffc337354ea938f5efee
	VINYL_PACKAGE_STRING='Vinyl Cache 9.0.1'
	VINYL_STRICT_ABI=423648c4cb6b225b3268ffc337354ea938f5efee
	VINYL_SOURCE_KIND=tarball
	VINYL_SOURCE_URL=https://vinyl-cache.org/downloads/vinyl-cache-9.0.1.tgz
	VINYL_SOURCE_SHA256=2e8ec67cd213ea6864c763939d64912025557342fad2a5ffda6c7c5b59bdeb17
	VINYL_VERSION=9.0.1
	VINYL_RELEASE=1

	# Author date of VINYL_GIT_COMMIT, 2026-05-18T10:38:47+02:00 (tag
	# vinyl-cache-9.0.1). Must equal recipes/debian-13/pins.env's release
	# block, which states the same rule.
	VINYL_SOURCE_DATE_EPOCH=1779093527

	# Derived 2026-07-26 from the tarball digest above, an empty patch
	# series, and production build-profile revision 1 -- the same formula
	# the trunk block's COHORT_ID comment describes. Unlike the trunk
	# value, this one predates its registry manifest: the manifest is
	# minted at the first release-track build, not before.
	COHORT_ID=vinyl-9.0.1-ac4f719c16f4
	;;
trunk)
	# Pinned source revision. The 40-hex commit id is also the strict VMOD
	# ABI token: Vinyl bakes "$(PACKAGE_STRING) $(VCS_Version)" into
	# include/vmod_abi.h.
	#
	# Re-pinned 2026-07-25 (packaging plan step 10) from
	# a90954814766d933a75d4c808c449cb9bc0ae3d3, an unpublished local branch
	# that carried 17 additive benchmark-scaffolding commits including an
	# in-tree vmod_tag. Packages must ship pure upstream Vinyl, and CI
	# cannot fetch a commit that is not on code.vinyl-cache.org. This is
	# that branch's merge-base with upstream main.
	VINYL_GIT_COMMIT=25761f8505817ac50df994270bfe75b60073e33e
	VINYL_PACKAGE_STRING='Vinyl Cache trunk'
	VINYL_STRICT_ABI=25761f8505817ac50df994270bfe75b60073e33e
	VINYL_SOURCE_KIND=git

	# Snapshot version convention shared with the Debian 13 lane. The
	# tilde is supported by EL9 rpm and sorts before a future 9.0.0
	# release, so an eventual real 9.0.0 package upgrades this snapshot
	# cleanly.
	VINYL_VERSION=9.0.0~git20260520.25761f8505
	VINYL_RELEASE=1

	# Commit author date of VINYL_GIT_COMMIT, 2026-05-20T10:18:13+02:00.
	# Must equal VINYL_SOURCE_DATE_EPOCH in recipes/debian-13/pins.env's
	# trunk block, which states the same rule. Before the 2026-07-25
	# re-pin the value here was 1781652621, which is
	# 2026-06-16T23:30:21Z and did NOT match this comment or the Debian
	# lane's 1781307021; the previous commit's author and committer dates
	# were identical, so nothing caught the four-day drift. Re-derived
	# from git for both lanes.
	VINYL_SOURCE_DATE_EPOCH=1779265093

	# Assigned 2026-07-26 by registry/cohorts/vinyl-9.0.0-4b7e68292979.yml,
	# the first real cohort. It replaces the template id
	# vinyl-9.0.0-000000000000, which existed only so that packages built
	# before the mint visibly carried a non-releasable identity. The
	# Debian lane's recipes/debian-13/pins.env carries the same value; the
	# two used to hold two different placeholders.
	#
	# The id is derived, not chosen: SHA-256 over the pinned Vinyl source
	# archive digest, the (empty) patch series and production
	# build-profile revision 1. Reproduce it with
	#   python3 tools/release_tool.py cohort-id --cohort vinyl-9.0.0-4b7e68292979
	# It is baked into vinyld(cohort-<id>) on the runtime and into
	# cachetag's Requires, so it must stay usable inside an RPM capability
	# name.
	COHORT_ID=vinyl-9.0.0-4b7e68292979
	;;
*)
	echo "E: unknown VINYL_TRACK '$VINYL_TRACK' (release|trunk)" >&2
	exit 2
	;;
esac

# --- cachetag ----------------------------------------------------------------

# The canonical source archive produced by Phase 1. Package jobs consume this
# archive and never a git checkout.
CACHETAG_VERSION=1.0.1
# Release restarts at 1: the upstream version moved, so the revision counter
# is new. (1.0.0-2 was never published; its lanes were proven unbuildable.)
CACHETAG_RELEASE=1
CACHETAG_TARBALL=libvmod-cachetag-1.0.1.tar.gz
# Re-pinned 2026-07-28 to the v1.0.1 release, which restores the
# docs/vmod_cachetag.rst file the v1.0.0 dist archive was missing -- v1.0.0
# could never build the packages its own recipes describe. CI verifies the
# annotated release tag, peeled commit, and deterministic archive digest.
CACHETAG_GIT_COMMIT=a3897aaccf1d6996c00ee14b2c6e1ddac91ac982
CACHETAG_SHA256=9aba3effcb20cfc70b77a4729990e3cd2ae1712ad242f4e4c45a664e1949eac2
# Committer date of CACHETAG_GIT_COMMIT. Must equal CACHETAG_SOURCE_DATE_EPOCH
# in recipes/debian-13/pins.env, which records the same value; the two pin
# files must agree, and commit, digest, and epoch move together on every
# re-pin. Until 2026-07-28 this lane had no cachetag epoch at all and dated
# the cachetag package from VINYL_SOURCE_DATE_EPOCH -- the wrong repository's
# history.
CACHETAG_SOURCE_DATE_EPOCH=1785230737
# Derived from src/Makefile.am's VTC_TESTS list in the pinned v1.0.1 archive
# (16 c + 7 r + 29 pm). Re-derive on every re-pin; it moves with
# CACHETAG_SHA256. The installed-package VTC suite refuses to run a ledger
# of any other size.
CACHETAG_VTC_COUNT=52
CACHETAG_SOURCE_URL=https://github.com/boffinate/libvmod-cachetag/releases/download/v1.0.1/libvmod-cachetag-1.0.1.tar.gz

# --- packaging identity ------------------------------------------------------

# Real identity, but the address deliberately does not accept mail; the
# support channel is the issue tracker reachable via each package's URL field.
# Decided 2026-07-25 (packaging plan step 2 identity).
MAINTAINER_NAME='Boffinate'
MAINTAINER_EMAIL=noreply@boffinate.com

# --- build environment -------------------------------------------------------

# Pinned by index digest (resolved 2026-07-25 via `docker buildx imagetools
# inspect almalinux:9`), matching the Debian lane's IMAGE_REF@IMAGE_DIGEST
# convention. The index digest resolves per-platform, so the same pin serves
# the local arm64 process proof and the x86_64 CI lane.
EL9_IMAGE=almalinux:9@sha256:d2515c769e7b73f95c4fde38c0a505336ff38f14990c0b7253b77060a049a743
