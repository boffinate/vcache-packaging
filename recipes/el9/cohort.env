# Pinned inputs for the EL9 lane.
#
# This file is a stand-in for the cohort/target registry manifests. The registry
# schema (registry/README.md) currently describes cachetag packages only; it has
# no fields for the Vinyl runtime/devel package version or for the Vinyl source
# archive, so those values cannot yet be generated with
# `tools/release_tool.py metadata`. Until the schema grows them, this file is the
# single place the EL9 lane reads its identity from: no version string, package
# revision or ABI hash is hand-written into a spec file.
#
# Every value here is an immutable input, not a build output.

# --- Vinyl Cache -------------------------------------------------------------

# Pinned source revision. The 40-hex commit id is also the strict VMOD ABI
# token: Vinyl bakes "$(PACKAGE_STRING) $(VCS_Version)" into include/vmod_abi.h.
#
# Re-pinned 2026-07-25 (packaging plan step 10) from
# a90954814766d933a75d4c808c449cb9bc0ae3d3, an unpublished local branch that
# carried 17 additive benchmark-scaffolding commits including an in-tree
# vmod_tag. Packages must ship pure upstream Vinyl, and CI cannot fetch a commit
# that is not on code.vinyl-cache.org. This is that branch's merge-base with
# upstream main.
VINYL_GIT_COMMIT=25761f8505817ac50df994270bfe75b60073e33e
VINYL_VTEST2_COMMIT=db5ccb4a078da40b3ec1ca3c18bf498bb1520888
VINYL_PACKAGE_STRING='Vinyl Cache trunk'
VINYL_STRICT_ABI=25761f8505817ac50df994270bfe75b60073e33e

# Snapshot version convention shared with the Debian 13 lane. The tilde is
# supported by EL9 rpm and sorts before a future 9.0.0 release, so an eventual
# real 9.0.0 package upgrades this snapshot cleanly.
VINYL_VERSION=9.0.0~git20260520.25761f8505
VINYL_RELEASE=1

# Commit author date of VINYL_GIT_COMMIT, 2026-05-20T10:18:13+02:00. Must equal
# VINYL_SOURCE_DATE_EPOCH in recipes/debian-13/build.sh, which states the same
# rule. Before the 2026-07-25 re-pin the value here was 1781652621, which is
# 2026-06-16T23:30:21Z and did NOT match this comment or the Debian lane's
# 1781307021; the previous commit's author and committer dates were identical,
# so nothing caught the four-day drift. Re-derived from git for both lanes.
VINYL_SOURCE_DATE_EPOCH=1779265093

# --- cachetag ----------------------------------------------------------------

# The canonical source archive produced by Phase 1. Package jobs consume this
# archive and never a git checkout.
CACHETAG_VERSION=1.0.0
CACHETAG_RELEASE=1
CACHETAG_TARBALL=libvmod-cachetag-1.0.0.tar.gz
CACHETAG_SHA256=c7054e69219ff3c54501d9c68857f2117944c4658db4cb08e2821b09b27821a2
CACHETAG_SOURCE_URL=https://github.com/boffinate/libvmod-cachetag/releases/download/v1.0.0/libvmod-cachetag-1.0.0.tar.gz

# --- cohort ------------------------------------------------------------------

# No real cohort identifier has been assigned yet: the plan forbids deriving one
# before the Vinyl source archive digest, patch series and production
# build-profile revision are pinned in the registry. The template id is used so
# the built packages visibly carry a non-releasable identity.
COHORT_ID=vinyl-9.0.0-000000000000

# --- packaging identity ------------------------------------------------------

# Real identity, but the address deliberately does not accept mail; the
# support channel is the issue tracker reachable via each package's URL field.
# Decided 2026-07-25 (packaging plan step 2 identity).
MAINTAINER_NAME='Boffinate'
MAINTAINER_EMAIL=noreply@boffinate.com

# --- build environment -------------------------------------------------------

# Pinned by index digest (resolved 2026-07-25 via `docker buildx imagetools
# inspect almalinux:9`), matching the Debian lane's IMAGE_REF@IMAGE_DIGEST
# convention. The index digest resolves per-platform, so the same pin serves
# the local arm64 process proof and the x86_64 CI lane.
EL9_IMAGE=almalinux:9@sha256:d2515c769e7b73f95c4fde38c0a505336ff38f14990c0b7253b77060a049a743
