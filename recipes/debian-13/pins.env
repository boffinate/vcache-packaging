#
# Pinned inputs for the Debian 13 lane -- the single definition of every
# compatibility input of the cohort.
#
# This file is sourced, not executed: by recipes/debian-13/build.sh, by
# scripts/ci/debian13/pinned.sh (the CI scripts run in their own shells and
# cannot see build.sh's variables), and by scripts/ci/release-manifest.sh.
# It exists because those three used to carry hand-mirrored copies, and on
# 2026-07-25 the cachetag re-pin moved CACHETAG_SOURCE_DATE_EPOCH in one of
# them and not the others -- a divergence no assertion could catch, because
# each copy was internally consistent. Add a value here, once, and every
# reader gets it.
#
# Plain sh assignments only: no command substitution (other than the trivial
# `$VAR` interpolation sh itself expands while assigning), no dependencies, so
# it can be sourced from a container, a buildroot, or the host alike.
#
# Two-track model, added 2026-07-26: "trunk" builds from the pinned Vinyl Cache
# Git snapshot below and exists to catch VMOD breakage and strict-ABI churn
# early; "release" builds from the upstream release tarball and is meant to be
# what users install. Select with VINYL_TRACK=release|trunk; it defaults to
# trunk FOR NOW. The default flips to release only after the first validated
# release-track build -- a later, separate change.
#

VTEST2_GIT_COMMIT=db5ccb4a078da40b3ec1ca3c18bf498bb1520888

# Canonical cachetag source archive. Package jobs consume this, never a Git
# checkout.
CACHETAG_VERSION=1.0.1
# Revision restarts at 1: the upstream version moved, so the revision counter
# is new. (1.0.0-2 was never published; its lanes were proven unbuildable.)
CACHETAG_PACKAGE_REVISION=1
CACHETAG_DEBIAN_VERSION=$CACHETAG_VERSION-$CACHETAG_PACKAGE_REVISION
# Re-pinned 2026-07-28 to the v1.0.1 release, which restores the
# docs/vmod_cachetag.rst file the v1.0.0 dist archive was missing -- v1.0.0
# could never build the packages its own recipes describe. CI checks out the
# annotated release tag, verifies its peeled commit below, and reproduces this
# digest. Digest, commit, and epoch move together.
CACHETAG_GIT_COMMIT=a3897aaccf1d6996c00ee14b2c6e1ddac91ac982
CACHETAG_SOURCE_SHA256=9aba3effcb20cfc70b77a4729990e3cd2ae1712ad242f4e4c45a664e1949eac2
CACHETAG_SOURCE_DATE_EPOCH=1785230737
# Derived from src/Makefile.am's VTC_TESTS list in the pinned v1.0.1 archive
# (16 c + 7 r + 29 pm). Re-derive on every re-pin; it moves with
# CACHETAG_SOURCE_SHA256. The installed-package VTC suite refuses to run a
# ledger of any other size.
CACHETAG_VTC_COUNT=52

DEBIAN_DISTRIBUTION=trixie

# Buildroot repository, pinned by mirror snapshot rather than merely recorded.
# The plan's Reproducibility section offers two options -- "pin buildroot
# repositories or record exact resolved package versions" -- and this is the
# stronger one: snapshot.debian.org serves the archive exactly as it stood at
# this instant, so the chroot mmdebstrap builds is reproducible rather than
# only auditable. Chosen 2026-07-25; measured from a runner as fast as the
# regular mirror (chroot built in 45-80s), so the throttling that usually
# argues against snapshot.debian.org did not materialise. The EL9 lane still
# uses record-and-audit (logs/buildroot-packages.tsv) because Mock resolves
# from AlmaLinux's live mirrors, which have no equivalent.
#
# The snapshot's Release file is older than its own Valid-Until allows, so
# both mmdebstrap and the chroot's apt need Acquire::Check-Valid-Until off.
DEBIAN_SNAPSHOT=20260701T000000Z
DEBIAN_SNAPSHOT_URI=https://snapshot.debian.org/archive/debian/$DEBIAN_SNAPSHOT/

# The maintainer address is real but deliberately does not accept mail; the
# support channel is the issue tracker reachable via each package's
# Homepage/Vcs fields. Decided 2026-07-25 (packaging plan step 2 identity).
MAINTAINER_NAME='Boffinate'
MAINTAINER_EMAIL='noreply@boffinate.com'

SOURCE_URL="https://github.com/boffinate/libvmod-cachetag/releases/download/v$CACHETAG_VERSION/libvmod-cachetag-$CACHETAG_VERSION.tar.gz"

# Buildroot identity, pinned by digest as the plan requires.
IMAGE_REF=${IMAGE_REF:-debian:trixie}
IMAGE_DIGEST=${IMAGE_DIGEST:-sha256:fac46bff2e02f51425b6e33b0e1169f55dfb053d83511ca28aa50c09fd5ed7a4}
IMAGE="$IMAGE_REF@$IMAGE_DIGEST"


# VRT version the built packages must advertise. This is the assertion, not
# the source of truth: the value is read out of the built tree by
# debian/rules, and the lane fails if the package disagrees with it.
VINYL_VRT_EXPECTED=${VINYL_VRT_EXPECTED:-23.0}

# --- Vinyl Cache source track --------------------------------------------
#
# Everything about which Vinyl Cache source the lane builds lives in this one
# dispatch, so no reader has to cross-reference a second file to know what
# VINYL_TRACK does. A case statement is still a plain sh assignment block --
# no command substitution, no external process -- so the file keeps its
# sourceable-anywhere contract.
VINYL_TRACK=${VINYL_TRACK:-trunk}
case $VINYL_TRACK in
release)
	# Drafted 2026-07-26, unexecuted until the first release-track build:
	# builds from the upstream release tarball rather than a Git checkout.
	# Tarball digest and baked ABI string verified against the downloaded
	# upstream tarball on 2026-07-26.
	VINYL_GIT_COMMIT=423648c4cb6b225b3268ffc337354ea938f5efee
	VINYL_STRICT_ABI=$VINYL_GIT_COMMIT
	VINYL_ABI_STRING="Vinyl Cache 9.0.1 $VINYL_GIT_COMMIT"
	VINYL_SOURCE_KIND=tarball
	VINYL_SOURCE_URL=https://vinyl-cache.org/downloads/vinyl-cache-9.0.1.tgz
	VINYL_SOURCE_SHA256=2e8ec67cd213ea6864c763939d64912025557342fad2a5ffda6c7c5b59bdeb17
	VINYL_UPSTREAM_VERSION=9.0.1
	VINYL_PACKAGE_REVISION=1
	VINYL_PACKAGE_VERSION=$VINYL_UPSTREAM_VERSION-$VINYL_PACKAGE_REVISION

	# Author date of VINYL_GIT_COMMIT, 2026-05-18T10:38:47+02:00 (tag
	# vinyl-cache-9.0.1). Same author-not-committer rule as the trunk block
	# below; the EL9 lane's cohort.env must carry the same number.
	VINYL_SOURCE_DATE_EPOCH=1779093527

	# Derived 2026-07-26 from the tarball digest above, an empty patch
	# series, and production build-profile revision 1 -- the same formula
	# the trunk block's COHORT_ID comment describes. Unlike the trunk
	# value, this one predates its registry manifest: the manifest is
	# minted at the first release-track build, not before.
	COHORT_ID='vinyl-9.0.1-ac4f719c16f4'
	;;
trunk)
	# Vinyl Cache source revision. The strict VMOD ABI token is, by
	# construction, this commit id: include/generate.py writes
	# VMOD_ABI_Version as "<PACKAGE_STRING> <commit>".
	#
	# Re-pinned 2026-07-25 (packaging plan step 10) from
	# a90954814766d933a75d4c808c449cb9bc0ae3d3 to this commit. The previous
	# pin was an unpublished local branch that carried 17 additive
	# benchmark-scaffolding commits on top of upstream, including an
	# in-tree vmod_tag that is a benchmark subject and not part of Vinyl.
	# Packages must ship pure upstream Vinyl, and CI cannot fetch a commit
	# that does not exist on code.vinyl-cache.org. This commit is the
	# merge-base of that branch with upstream main.
	VINYL_GIT_COMMIT=25761f8505817ac50df994270bfe75b60073e33e
	VINYL_STRICT_ABI=$VINYL_GIT_COMMIT
	VINYL_ABI_STRING="Vinyl Cache trunk $VINYL_GIT_COMMIT"
	VINYL_SOURCE_KIND=git

	# Digest of the canonical pinned Vinyl source archive, produced by the
	# identical assembly procedure as
	# libvmod-cachetag/scripts/release-source-archive.sh.
	#
	# Re-derived 2026-07-25 by the source stage below, because the re-pin
	# of VINYL_GIT_COMMIT deliberately changed the archive's input. The
	# metadata sidecar's vinyl_input block is provenance for the Vinyl
	# prefix the VMOD was test-built against, not an input to the cachetag
	# archive; the archive digest is a function of the cachetag commit
	# alone (content plus mtimes pinned to its committer date).
	VINYL_SOURCE_SHA256=27568cc1cdf914b3a328fc633d90137b62134fc7d375ca16010656a26d53f507

	# Snapshot version convention, shared with the EL9 lane: 9.0.0~git
	# <commit date in the commit's own timezone><10-char short hash>. This
	# is a pre-9.0.0 experimental snapshot: Vinyl's own AC_INIT still says
	# "trunk".
	VINYL_UPSTREAM_VERSION=9.0.0~git20260520.25761f8505
	VINYL_PACKAGE_REVISION=1
	VINYL_PACKAGE_VERSION=$VINYL_UPSTREAM_VERSION-$VINYL_PACKAGE_REVISION

	# Commit AUTHOR date of VINYL_GIT_COMMIT, 2026-05-20T10:18:13+02:00,
	# used as SOURCE_DATE_EPOCH for the Vinyl lane. Author rather than
	# committer date: the author date survives a rebase, and the previous
	# pin's value (1781307021) was also its author date. The EL9 lane's
	# cohort.env states the same rule and must carry the same number; at
	# the previous pin the two commit dates were identical, which hid a
	# stale value there. Do not let these two diverge.
	VINYL_SOURCE_DATE_EPOCH=1779265093

	# No cohort identifier is minted here. The registry assigns it; this
	# build reports every input the assignment needs.
	#
	# The value is baked into the runtime package's vinyld-cohort-<id>
	# provide and into cachetag's dependency on it, so it has to be usable
	# inside a Debian package name: [a-z0-9] first, then [a-z0-9+.-].
	# debian/rules asserts that before emitting the substvar rather than
	# letting dpkg-gencontrol produce a malformed relation.
	#
	# Assigned 2026-07-26 by registry/cohorts/vinyl-9.0.0-4b7e68292979.yml,
	# replacing the placeholder 'unassigned-local-process-proof'. The
	# input-id is the SHA-256 of VINYL_SOURCE_SHA256 above, an empty patch
	# series, and production build-profile revision 1; reproduce it with
	#   python3 tools/release_tool.py cohort-id --cohort vinyl-9.0.0-4b7e68292979
	# Changing any of those three inputs mints a different cohort, and this
	# value must then be updated from the registry rather than edited by
	# hand.
	COHORT_ID='vinyl-9.0.0-4b7e68292979'
	;;
*)
	echo "E: unknown VINYL_TRACK '$VINYL_TRACK' (release|trunk)" >&2
	exit 2
	;;
esac
