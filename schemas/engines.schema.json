{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "vcache engines.yml",
  "type": "object",
  "description": "Hand-maintained engine catalog. Authority is 'python3 tools/matrix.py validate'; this schema is editor assistance only (DESIGN.md decision 11).",
  "additionalProperties": false,
  "required": [
    "engines",
    "schema"
  ],
  "properties": {
    "schema": {
      "const": "engines/1",
      "description": "Schema marker; must be 'engines/1'."
    },
    "engines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "description": "One engine version we test and/or package against.",
        "additionalProperties": false,
        "required": [
          "family",
          "id",
          "kind",
          "series",
          "source",
          "targets"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Engine id, '<family>-<version>'. The version half is derived from it, so 'vinyl-9.0.1' yields version 9.0.1."
          },
          "family": {
            "type": "string",
            "minLength": 1,
            "description": "Upstream project.",
            "enum": [
              "vinyl",
              "varnish"
            ]
          },
          "series": {
            "type": "string",
            "minLength": 1,
            "description": "Series this engine belongs to, matched by a VMOD's sources.by_series keys (e.g. 'vinyl-9.0')."
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "description": "'release' pins a tarball; 'trunk' builds a branch HEAD.",
            "enum": [
              "release",
              "trunk"
            ]
          },
          "source": {
            "type": "object",
            "description": "Where the engine source comes from. A release engine takes tarball_url + sha256; a trunk engine takes git_url + branch.",
            "additionalProperties": false,
            "properties": {
              "tarball_url": {
                "type": "string",
                "minLength": 1,
                "description": "Release tarball URL (kind: release).",
                "format": "uri"
              },
              "sha256": {
                "type": "string",
                "minLength": 1,
                "description": "SHA-256 of the tarball, quoted (kind: release)."
              },
              "git_url": {
                "type": "string",
                "minLength": 1,
                "description": "Clone URL (kind: trunk).",
                "format": "uri"
              },
              "branch": {
                "type": "string",
                "minLength": 1,
                "description": "Branch built as it stands; no pin (kind: trunk)."
              }
            }
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Build targets, e.g. debian-13-amd64, el9-x86_64."
          },
          "packages": {
            "type": "string",
            "minLength": 1,
            "description": "Quoted \"true\" if this engine is packaged, not merely tested. Requires kind: release and family: vinyl. Defaults to \"false\".",
            "enum": [
              "true",
              "false"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "release"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "source": {
                  "required": [
                    "sha256",
                    "tarball_url"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "git_url"
                        ]
                      },
                      {
                        "required": [
                          "branch"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "trunk"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "source": {
                  "required": [
                    "branch",
                    "git_url"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "tarball_url"
                        ]
                      },
                      {
                        "required": [
                          "sha256"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "packages": {
                  "const": "true"
                }
              },
              "required": [
                "packages"
              ]
            },
            "then": {
              "properties": {
                "kind": {
                  "const": "release"
                },
                "family": {
                  "const": "vinyl"
                }
              },
              "description": "packages \"true\" requires kind: release and family: vinyl."
            }
          }
        ]
      },
      "description": "Every engine version, in matrix column order."
    }
  }
}
