# Configuration file for Vinyl Cache
#
# /etc/init.d/vinyl-cache expects the variable $DAEMON_OPTS to be set from this
# shell script fragment.
#

# Maximum number of open files (for ulimit -n)
NFILES=131072

# Locked shared memory (for ulimit -l)
# Default log size is 82MB + header
MEMLOCK=82000

# Maximum number of threads (for ulimit -u)
NPROCS="unlimited"

# Maximum size of corefile (for ulimit -c). Default in Fedora is 0
# DAEMON_COREFILE_LIMIT="unlimited"

# Init script support to reload/switch vcl without restart.
# To make this work, you need to set the following variables
# explicit: VINYL_VCL_CONF.
RELOAD_VCL=1

# Main configuration file.
VINYL_VCL_CONF=/etc/vinyl-cache/default.vcl
#
# Default address and port to bind to
# Blank address means all IPv4 and IPv6 interfaces, otherwise specify
# a host name, an IPv4 dotted quad, or an IPv6 address in brackets.
VINYL_LISTEN_PORT=6081
#
#
# The minimum number of worker threads to start
VINYL_MIN_THREADS=50
#
# The Maximum number of worker threads to start
VINYL_MAX_THREADS=1000
#
# Cache file size: in bytes, optionally using k / M / G / T suffix.
VINYL_STORAGE_SIZE=256M
#
# Backend storage specification
VINYL_STORAGE="malloc,${VINYL_STORAGE_SIZE}"
#
# Default TTL used when the backend does not specify one
VINYL_TTL=120
#
# DAEMON_OPTS is used by the init script.
DAEMON_OPTS="-a ${VINYL_LISTEN_ADDRESS}:${VINYL_LISTEN_PORT} \
             -f ${VINYL_VCL_CONF} \
             -p thread_pool_min=${VINYL_MIN_THREADS} \
             -p thread_pool_max=${VINYL_MAX_THREADS} \
             -s ${VINYL_STORAGE}"
