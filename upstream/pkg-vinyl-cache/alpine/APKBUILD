# this is a slimmed-down version of https://git.alpinelinux.org/aports/tree/main/varnish/APKBUILD
#
# before this can be used:
# - run "abuild checksum" to regenerate the sha512sums variable
# - replace @VERSION@ with the actual version to use
#
# relevant reading: https://wiki.alpinelinux.org/wiki/Creating_an_Alpine_package
#
# Contributor: Pedro Filipe <xpecex@outlook.com>
# Contributor: Leonardo Arena <rnalrd@alpinelinux.org>
# Contributor: V.Krishn <vkrishn4@gmail.com>
# Contributor: Natanael Copa <ncopa@alpinelinux.org>
pkgname=vinyl-cache
pkgver=@VERSION@
pkgrel=1
pkgdesc="High-performance HTTP accelerator"
url="https://vinyl-cache.org/"
arch="all"
license="BSD"
options="!check" # tests pass, but ran before packaging
depends="gcc libc-dev libgcc"
depends_dev=
makedepends="$depends_dev pcre-dev pcre2-dev ncurses-dev libedit-dev py-docutils
	linux-headers libunwind-dev python3 py3-sphinx"
install="$pkgname.pre-install"
subpackages="$pkgname-dbg $pkgname-dev $pkgname-doc $pkgname-libs"
pkgusers="vinyl"
pkggroups="vinyl"
source="$pkgname-$pkgver.tar.gz"

builddir="$srcdir/$pkgname-$pkgver"

build() {
	cd "$builddir"
	./configure \
		--build="$CBUILD" \
		--host="$CHOST" \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--localstatedir=/var/lib \
		--without-jemalloc \
		--with-contrib \
		--with-unwind
	make
}

check() {
	cd "$builddir"

	make -j12 check VERBOSE=1
}

package() {
	cd "$builddir"

	make DESTDIR="$pkgdir" install

	install -d -o vinyl -g vinyl -m750 \
		"$pkgdir"/var/cache/vinyl-cache \
		"$pkgdir"/var/log/vinyl-cache \
		"$pkgdir"/var/lib/vinyl-cache
	install -d -o root -g vinyl -m750 "$pkgdir"/etc/vinyl-cache
	install    -o root -g vinyl -m755 "$startdir"/vinylreload "$pkgdir"/usr/bin
}

sha512sums="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX  vinyl-cache-$pkgver.tar.gz"
